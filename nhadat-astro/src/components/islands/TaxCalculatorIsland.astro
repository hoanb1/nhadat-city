---
---

<div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm" id="tax-island">
  <div class="space-y-5">
    <!-- Property Value Slider -->
    <div>
      <div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-1">
        <span>Giá trị chuyển nhượng trên hợp đồng (VND)</span>
        <span id="tax-val-display" class="text-brand-600 font-bold text-sm">3,500,000,000 đ (3.5 tỷ)</span>
      </div>
      <input
        type="range"
        id="tax-val-slider"
        min="300000000"
        max="30000000000"
        value="3500000000"
        step="100000000"
        class="w-full accent-brand-600 cursor-pointer"
      />
    </div>

    <!-- Exempt Checkboxes -->
    <div class="space-y-2">
      <div class="flex items-center gap-2 p-3 rounded-xl bg-slate-50 border border-slate-200">
        <input type="checkbox" id="tax-family" class="rounded text-brand-600 focus:ring-brand-500 w-4 h-4" />
        <label for="tax-family" class="text-xs font-medium text-slate-800">
          Chuyển nhượng/Tặng cho giữa người thân ruột thịt (Bố mẹ - con cái, vợ - chồng, anh chị em) &rarr; <span class="text-emerald-700 font-bold">Miễn 100% Thuế TNCN & Lệ phí trước bạ</span>
        </label>
      </div>

      <div class="flex items-center gap-2 p-3 rounded-xl bg-slate-50 border border-slate-200">
        <input type="checkbox" id="tax-only-house" class="rounded text-brand-600 focus:ring-brand-500 w-4 h-4" />
        <label for="tax-only-house" class="text-xs font-medium text-slate-800">
          Người bán chỉ sở hữu duy nhất 01 nhà ở / thửa đất ở tại Việt Nam &rarr; <span class="text-emerald-700 font-bold">Miễn thuế TNCN 2%</span>
        </label>
      </div>
    </div>

    <!-- Output Tax Breakdown -->
    <div class="mt-6 p-5 rounded-2xl bg-gradient-to-br from-slate-900 to-slate-850 text-white shadow-lg space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div>
          <span class="text-xs text-slate-400">Tổng Thuế & Lệ Phí Phải Nộp</span>
          <div id="tax-total" class="text-2xl sm:text-3xl font-extrabold text-amber-400 tracking-tight">
            90,350,000 đ
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
        <div class="p-2.5 rounded-lg bg-slate-800/80 border border-slate-700">
          <span class="text-slate-400 block">1. Thuế Thu Nhập Cá Nhân (2%):</span>
          <span id="tax-pit" class="text-white font-bold text-sm">70,000,000 đ</span>
          <span class="text-[10px] text-slate-400 block mt-0.5">Bên chuyển nhượng (người bán) nộp</span>
        </div>

        <div class="p-2.5 rounded-lg bg-slate-800/80 border border-slate-700">
          <span class="text-slate-400 block">2. Lệ Phí Trước Bạ (0.5%):</span>
          <span id="tax-registration" class="text-white font-bold text-sm">17,500,000 đ</span>
          <span class="text-[10px] text-slate-400 block mt-0.5">Bên nhận chuyển nhượng (người mua) nộp</span>
        </div>

        <div class="p-2.5 rounded-lg bg-slate-800/80 border border-slate-700">
          <span class="text-slate-400 block">3. Phí Công Chứng Hợp Đồng:</span>
          <span id="tax-notary" class="text-white font-bold text-sm">2,450,000 đ</span>
          <span class="text-[10px] text-slate-400 block mt-0.5">Theo Thông tư 257/2016/TT-BTC</span>
        </div>

        <div class="p-2.5 rounded-lg bg-slate-800/80 border border-slate-700">
          <span class="text-slate-400 block">4. Phí Thẩm Định Địa Chính & Cấp Sổ:</span>
          <span id="tax-cadastral" class="text-white font-bold text-sm">400,000 đ</span>
          <span class="text-[10px] text-slate-400 block mt-0.5">Mức thu cấp tỉnh/thành phố</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const taxSlider = document.getElementById('tax-val-slider') as HTMLInputElement;
  const taxValDisplay = document.getElementById('tax-val-display');
  const familyCheck = document.getElementById('tax-family') as HTMLInputElement;
  const onlyHouseCheck = document.getElementById('tax-only-house') as HTMLInputElement;
  const taxTotal = document.getElementById('tax-total');
  const taxPit = document.getElementById('tax-pit');
  const taxReg = document.getElementById('tax-registration');
  const taxNotary = document.getElementById('tax-notary');
  const taxCadastral = document.getElementById('tax-cadastral');

  function fmt(n: number): string {
    return new Intl.NumberFormat('vi-VN').format(Math.round(n)) + ' đ';
  }

  function calcNotary(val: number): number {
    if (val <= 50000000) return 50000;
    if (val <= 100000000) return 100000;
    if (val <= 1000000000) return val * 0.001;
    if (val <= 3000000000) return 1000000 + (val - 1000000000) * 0.0006;
    if (val <= 5000000000) return 2200000 + (val - 3000000000) * 0.0005;
    if (val <= 10000000000) return 3200000 + (val - 5000000000) * 0.0004;
    return Math.min(5200000 + (val - 10000000000) * 0.0003, 70000000);
  }

  function recalcTax() {
    const val = parseFloat(taxSlider.value);
    const isFam = familyCheck.checked;
    const isOnly = onlyHouseCheck.checked;

    if (taxValDisplay) {
      const b = val / 1000000000;
      taxValDisplay.textContent = `${fmt(val)} (${b >= 1 ? b.toFixed(1) + ' tỷ' : (val / 1000000) + ' triệu'})`;
    }

    const pit = (isFam || isOnly) ? 0 : Math.round(val * 0.02);
    const reg = isFam ? 0 : Math.min(Math.round(val * 0.005), 500000000);
    const notary = Math.round(calcNotary(val));
    const cadastral = 400000;
    const total = pit + reg + notary + cadastral;

    if (taxPit) taxPit.textContent = pit === 0 ? '0 đ (Được Miễn Thuế)' : fmt(pit);
    if (taxReg) taxReg.textContent = reg === 0 ? '0 đ (Được Miễn Thuế)' : fmt(reg);
    if (taxNotary) taxNotary.textContent = fmt(notary);
    if (taxCadastral) taxCadastral.textContent = fmt(cadastral);
    if (taxTotal) taxTotal.textContent = fmt(total);
  }

  taxSlider?.addEventListener('input', recalcTax);
  familyCheck?.addEventListener('change', recalcTax);
  onlyHouseCheck?.addEventListener('change', recalcTax);
</script>
