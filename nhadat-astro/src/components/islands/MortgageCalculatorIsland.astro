---
import { BANKS } from '../../lib/constants/banks';

interface Props {
  initialBankSlug?: string;
}

const { initialBankSlug = 'vietcombank' } = Astro.props;
const currentBank = BANKS.find((b) => b.slug === initialBankSlug) || BANKS[0];
---

<div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm" id="mortgage-island">
  <div class="space-y-5">
    <!-- Bank Selector -->
    <div>
      <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
        Chọn Gói Vay Ngân Hàng (35 Ngân Hàng)
      </label>
      <select
        id="mort-bank-select"
        class="w-full rounded-lg border-slate-300 text-sm font-medium focus:ring-brand-500 focus:border-brand-500 p-2.5 bg-slate-50 border"
      >
        {BANKS.map((b) => (
          <option value={b.slug} data-rate={b.promo_rate_12m} selected={b.slug === currentBank.slug}>
            {b.bank_name} — Ưu đãi {b.promo_rate_12m}%/năm
          </option>
        ))}
      </select>
    </div>

    <!-- Loan Amount Slider -->
    <div>
      <div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-1">
        <span>Số tiền vay (VND)</span>
        <span id="mort-amount-display" class="text-brand-600 font-bold text-sm">2,000,000,000 đ (2 tỷ)</span>
      </div>
      <input
        type="range"
        id="mort-amount-slider"
        min="200000000"
        max="15000000000"
        value="2000000000"
        step="100000000"
        class="w-full accent-brand-600 cursor-pointer"
      />
    </div>

    <!-- Term Slider -->
    <div>
      <div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-1">
        <span>Thời hạn vay (Năm)</span>
        <span id="mort-term-display" class="text-brand-600 font-bold text-sm">20 năm (240 tháng)</span>
      </div>
      <input
        type="range"
        id="mort-term-slider"
        min="1"
        max="35"
        value="20"
        step="1"
        class="w-full accent-brand-600 cursor-pointer"
      />
    </div>

    <!-- Rate Slider -->
    <div>
      <div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-1">
        <span>Lãi suất năm (%/năm)</span>
        <span id="mort-rate-display" class="text-brand-600 font-bold text-sm">{currentBank.promo_rate_12m}%/năm</span>
      </div>
      <input
        type="range"
        id="mort-rate-slider"
        min="4"
        max="14"
        value={currentBank.promo_rate_12m}
        step="0.1"
        class="w-full accent-brand-600 cursor-pointer"
      />
    </div>

    <!-- Repayment Method Toggle -->
    <div>
      <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
        Phương Thức Trả Nợ
      </label>
      <div class="grid grid-cols-2 gap-2">
        <button
          type="button"
          id="btn-method-decreasing"
          class="py-2.5 px-3 rounded-lg border text-xs font-semibold bg-brand-50 border-brand-600 text-brand-700 text-center"
        >
          Dư Nợ Giảm Dần (Phổ biến nhất)
        </button>
        <button
          type="button"
          id="btn-method-annuity"
          class="py-2.5 px-3 rounded-lg border text-xs font-semibold bg-white border-slate-200 text-slate-600 hover:bg-slate-50 text-center"
        >
          Trả Góp Đều (Annuity)
        </button>
      </div>
    </div>

    <!-- Results Card -->
    <div class="mt-6 p-5 rounded-2xl bg-gradient-to-br from-slate-900 to-slate-850 text-white shadow-lg space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div>
          <span class="text-xs text-slate-400">Thanh Toán Tháng Đầu Tiên (Gốc + Lãi)</span>
          <div id="mort-first-month" class="text-2xl sm:text-3xl font-extrabold text-brand-400 tracking-tight">
            18,333,333 đ
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 text-xs font-medium">
        <div>
          <span class="text-slate-400 block">Tổng Lãi Phải Trả:</span>
          <span id="mort-total-interest" class="text-amber-400 text-sm font-bold">1,205,000,000 đ</span>
        </div>
        <div>
          <span class="text-slate-400 block">Tổng Gốc + Lãi Cả Kỳ:</span>
          <span id="mort-total-payment" class="text-white text-sm font-bold">3,205,000,000 đ</span>
        </div>
      </div>
    </div>

    <!-- 12-Month Amortization Schedule Table -->
    <div class="mt-6 border-t border-slate-100 pt-5">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-800">
            Lịch Trả Nợ 12 Tháng Đầu Tiên
          </h4>
          <p class="text-[11px] text-slate-500 mt-0.5">Bảng chi tiết số tiền gốc, lãi và dư nợ thực tế từng tháng</p>
        </div>
        <span class="text-[11px] font-semibold text-brand-700 bg-brand-50 px-2 py-0.5 rounded border border-brand-200">
          Năm Thứ 1
        </span>
      </div>

      <div class="overflow-x-auto rounded-xl border border-slate-200">
        <table class="w-full text-left text-xs divide-y divide-slate-100">
          <thead class="bg-slate-50 text-slate-600 font-semibold uppercase text-[10px]">
            <tr>
              <th class="py-2.5 px-3">Kỳ (Tháng)</th>
              <th class="py-2.5 px-3 text-right">Gốc Phải Trả</th>
              <th class="py-2.5 px-3 text-right">Lãi Phải Trả</th>
              <th class="py-2.5 px-3 text-right font-bold text-brand-700">Tổng Trả (Gốc + Lãi)</th>
              <th class="py-2.5 px-3 text-right">Dư Nợ Còn Lại</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-mono text-[11px]" id="mort-schedule-tbody">
            <!-- Dynamically populated via script -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  const bankSelect = document.getElementById('mort-bank-select') as HTMLSelectElement;
  const amountSlider = document.getElementById('mort-amount-slider') as HTMLInputElement;
  const amountDisplay = document.getElementById('mort-amount-display');
  const termSlider = document.getElementById('mort-term-slider') as HTMLInputElement;
  const termDisplay = document.getElementById('mort-term-display');
  const rateSlider = document.getElementById('mort-rate-slider') as HTMLInputElement;
  const rateDisplay = document.getElementById('mort-rate-display');
  const btnDecreasing = document.getElementById('btn-method-decreasing');
  const btnAnnuity = document.getElementById('btn-method-annuity');
  const firstMonthDisplay = document.getElementById('mort-first-month');
  const totalInterestDisplay = document.getElementById('mort-total-interest');
  const totalPaymentDisplay = document.getElementById('mort-total-payment');

  let currentMethod = 'decreasing';

  btnDecreasing?.addEventListener('click', () => {
    currentMethod = 'decreasing';
    btnDecreasing.className = 'py-2.5 px-3 rounded-lg border text-xs font-semibold bg-brand-50 border-brand-600 text-brand-700 text-center';
    btnAnnuity!.className = 'py-2.5 px-3 rounded-lg border text-xs font-semibold bg-white border-slate-200 text-slate-600 hover:bg-slate-50 text-center';
    recalcMortgage();
  });

  btnAnnuity?.addEventListener('click', () => {
    currentMethod = 'annuity';
    btnAnnuity.className = 'py-2.5 px-3 rounded-lg border text-xs font-semibold bg-brand-50 border-brand-600 text-brand-700 text-center';
    btnDecreasing!.className = 'py-2.5 px-3 rounded-lg border text-xs font-semibold bg-white border-slate-200 text-slate-600 hover:bg-slate-50 text-center';
    recalcMortgage();
  });

  bankSelect?.addEventListener('change', () => {
    const selectedOption = bankSelect.options[bankSelect.selectedIndex];
    const rate = parseFloat(selectedOption.getAttribute('data-rate') || '6.5');
    rateSlider.value = rate.toString();
    recalcMortgage();
  });

  function formatMoney(num: number): string {
    return new Intl.NumberFormat('vi-VN').format(Math.round(num)) + ' đ';
  }

  function recalcMortgage() {
    const amount = parseFloat(amountSlider.value);
    const years = parseInt(termSlider.value);
    const months = years * 12;
    const rateYear = parseFloat(rateSlider.value);
    const rateMonth = rateYear / 100 / 12;

    if (amountDisplay) {
      const billion = amount / 1000000000;
      amountDisplay.textContent = `${formatMoney(amount)} (${billion >= 1 ? billion.toFixed(1) + ' tỷ' : (amount / 1000000) + ' triệu'})`;
    }
    if (termDisplay) termDisplay.textContent = `${years} năm (${months} tháng)`;
    if (rateDisplay) rateDisplay.textContent = `${rateYear.toFixed(1)}%/năm`;

    let firstMonth = 0;
    let totalInterest = 0;

    if (currentMethod === 'decreasing') {
      const monthlyPrincipal = amount / months;
      firstMonth = monthlyPrincipal + amount * rateMonth;
      totalInterest = ((amount * rateMonth) * (months + 1)) / 2;
    } else {
      // Annuity
      const monthlyPmt = (amount * (rateMonth * Math.pow(1 + rateMonth, months))) / (Math.pow(1 + rateMonth, months) - 1);
      firstMonth = monthlyPmt;
      totalInterest = monthlyPmt * months - amount;
    }

    if (firstMonthDisplay) firstMonthDisplay.textContent = formatMoney(firstMonth);
    if (totalInterestDisplay) totalInterestDisplay.textContent = formatMoney(totalInterest);
    if (totalPaymentDisplay) totalPaymentDisplay.textContent = formatMoney(amount + totalInterest);

    // Populate 12-Month Amortization Schedule
    const tbody = document.getElementById('mort-schedule-tbody');
    let balance = amount;
    let scheduleRows = '';

    if (currentMethod === 'decreasing') {
      const monthlyPrincipal = amount / months;
      for (let m = 1; m <= 12; m++) {
        const interest = balance * rateMonth;
        const totalPmt = monthlyPrincipal + interest;
        balance = Math.max(0, balance - monthlyPrincipal);

        scheduleRows += `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="py-2.5 px-3 font-semibold text-slate-900">Tháng ${m}</td>
            <td class="py-2.5 px-3 text-right text-slate-700">${formatMoney(monthlyPrincipal)}</td>
            <td class="py-2.5 px-3 text-right text-amber-600">${formatMoney(interest)}</td>
            <td class="py-2.5 px-3 text-right font-bold text-brand-700">${formatMoney(totalPmt)}</td>
            <td class="py-2.5 px-3 text-right text-slate-500">${formatMoney(balance)}</td>
          </tr>
        `;
      }
    } else {
      // Annuity (Equal payment)
      const monthlyPmt = (amount * (rateMonth * Math.pow(1 + rateMonth, months))) / (Math.pow(1 + rateMonth, months) - 1);
      for (let m = 1; m <= 12; m++) {
        const interest = balance * rateMonth;
        const principal = monthlyPmt - interest;
        balance = Math.max(0, balance - principal);

        scheduleRows += `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="py-2.5 px-3 font-semibold text-slate-900">Tháng ${m}</td>
            <td class="py-2.5 px-3 text-right text-slate-700">${formatMoney(principal)}</td>
            <td class="py-2.5 px-3 text-right text-amber-600">${formatMoney(interest)}</td>
            <td class="py-2.5 px-3 text-right font-bold text-brand-700">${formatMoney(monthlyPmt)}</td>
            <td class="py-2.5 px-3 text-right text-slate-500">${formatMoney(balance)}</td>
          </tr>
        `;
      }
    }

    if (tbody) tbody.innerHTML = scheduleRows;
  }

  amountSlider?.addEventListener('input', recalcMortgage);
  termSlider?.addEventListener('input', recalcMortgage);
  rateSlider?.addEventListener('input', recalcMortgage);

  // Initial calculation on load
  recalcMortgage();
</script>
