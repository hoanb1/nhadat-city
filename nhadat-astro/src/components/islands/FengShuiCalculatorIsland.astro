---
import { CUNG_PHI_DATA, calculateFengShui } from '../../lib/constants/fengShui';

const defaultResult = calculateFengShui(1988, 'nam');
---

<div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm" id="fengshui-island">
  <div class="space-y-5">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Birth year -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
          Năm Sinh Dương Lịch (Gia Chủ)
        </label>
        <select
          id="fs-year"
          class="w-full rounded-lg border-slate-300 text-sm font-medium focus:ring-brand-500 focus:border-brand-500 p-2.5 bg-slate-50 border"
        >
          {Array.from({ length: 77 }, (_, i) => 2026 - i).map((y) => (
            <option value={y} selected={y === 1988}>
              Năm {y}
            </option>
          ))}
        </select>
      </div>

      <!-- Gender -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
          Giới Tính Gia Chủ
        </label>
        <div class="grid grid-cols-2 gap-2">
          <button
            type="button"
            id="btn-gender-nam"
            class="py-2.5 px-3 rounded-lg border text-xs font-semibold bg-brand-50 border-brand-600 text-brand-700 text-center"
          >
            Nam Mạng
          </button>
          <button
            type="button"
            id="btn-gender-nu"
            class="py-2.5 px-3 rounded-lg border text-xs font-semibold bg-white border-slate-200 text-slate-600 hover:bg-slate-50 text-center"
          >
            Nữ Mạng
          </button>
        </div>
      </div>
    </div>

    <!-- Output Card -->
    <div class="p-5 rounded-2xl bg-gradient-to-br from-slate-900 to-slate-850 text-white shadow-lg space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div>
          <span class="text-xs text-slate-400" id="fs-can-chi">Tuổi Mậu Thìn (1988)</span>
          <div class="text-2xl font-extrabold text-white tracking-tight flex items-center gap-2">
            <span>Cung Phi: <span id="fs-cung" class="text-emerald-400">{defaultResult.cung_phi}</span></span>
            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-brand-500/20 text-brand-300" id="fs-group">
              {defaultResult.group}
            </span>
          </div>
        </div>
        <div class="text-right">
          <span class="text-xs text-slate-400">Quái Số</span>
          <div class="text-3xl font-extrabold text-brand-400" id="fs-quai">
            {defaultResult.quai_so}
          </div>
        </div>
      </div>

      <!-- 4 Good Directions -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-2 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          4 Hướng Đại Cát Hợp Mệnh (Nên Đặt Cửa Chính, Bàn Thờ, Phòng Ngủ)
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs" id="fs-good-list">
          {defaultResult.favorable_directions.map((d) => (
            <div class="p-2.5 rounded-lg bg-emerald-950/40 border border-emerald-800/60">
              <div class="flex justify-between font-bold text-emerald-300">
                <span>{d.direction}</span>
                <span>{d.star} ({d.score}đ)</span>
              </div>
              <p class="text-[11px] text-slate-400 mt-1 leading-snug">{d.meaning}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- 4 Bad Directions -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-rose-400 mb-2 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span>
          4 Hướng Hung Kỵ (Nên Đặt Nhà Vệ Sinh, Bếp Để Trấn Áp)
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs" id="fs-bad-list">
          {defaultResult.unfavorable_directions.map((d) => (
            <div class="p-2.5 rounded-lg bg-rose-950/30 border border-rose-900/50">
              <div class="flex justify-between font-bold text-rose-300">
                <span>{d.direction}</span>
                <span>{d.star} ({d.severity})</span>
              </div>
              <p class="text-[11px] text-slate-400 mt-1 leading-snug">{d.warning}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateFengShui } from '../../lib/constants/fengShui';

  const yearSelect = document.getElementById('fs-year') as HTMLSelectElement;
  const btnNam = document.getElementById('btn-gender-nam');
  const btnNu = document.getElementById('btn-gender-nu');
  const canChiEl = document.getElementById('fs-can-chi');
  const cungEl = document.getElementById('fs-cung');
  const groupEl = document.getElementById('fs-group');
  const quaiEl = document.getElementById('fs-quai');
  const goodList = document.getElementById('fs-good-list');
  const badList = document.getElementById('fs-bad-list');

  let currentGender: 'nam' | 'nu' = 'nam';

  btnNam?.addEventListener('click', () => {
    currentGender = 'nam';
    btnNam.className = 'py-2.5 px-3 rounded-lg border text-xs font-semibold bg-brand-50 border-brand-600 text-brand-700 text-center';
    btnNu!.className = 'py-2.5 px-3 rounded-lg border text-xs font-semibold bg-white border-slate-200 text-slate-600 hover:bg-slate-50 text-center';
    update();
  });

  btnNu?.addEventListener('click', () => {
    currentGender = 'nu';
    btnNu.className = 'py-2.5 px-3 rounded-lg border text-xs font-semibold bg-brand-50 border-brand-600 text-brand-700 text-center';
    btnNam!.className = 'py-2.5 px-3 rounded-lg border text-xs font-semibold bg-white border-slate-200 text-slate-600 hover:bg-slate-50 text-center';
    update();
  });

  yearSelect?.addEventListener('change', update);

  function update() {
    const y = parseInt(yearSelect.value);
    const res = calculateFengShui(y, currentGender);

    if (canChiEl) canChiEl.textContent = `Tuổi ${res.can_chi} (${y}) - ${currentGender === 'nam' ? 'Nam' : 'Nữ'} Mạng`;
    if (cungEl) cungEl.textContent = res.cung_phi;
    if (groupEl) groupEl.textContent = res.group;
    if (quaiEl) quaiEl.textContent = res.quai_so.toString();

    if (goodList) {
      goodList.innerHTML = res.favorable_directions.map((d) => `
        <div class="p-2.5 rounded-lg bg-emerald-950/40 border border-emerald-800/60">
          <div class="flex justify-between font-bold text-emerald-300">
            <span>${d.direction}</span>
            <span>${d.star} (${d.score}đ)</span>
          </div>
          <p class="text-[11px] text-slate-400 mt-1 leading-snug">${d.meaning}</p>
        </div>
      `).join('');
    }

    if (badList) {
      badList.innerHTML = res.unfavorable_directions.map((d) => `
        <div class="p-2.5 rounded-lg bg-rose-950/30 border border-rose-900/50">
          <div class="flex justify-between font-bold text-rose-300">
            <span>${d.direction}</span>
            <span>${d.star} (${d.severity})</span>
          </div>
          <p class="text-[11px] text-slate-400 mt-1 leading-snug">${d.warning}</p>
        </div>
      `).join('');
    }

    // Synchronize vector compass needle & labels
    window.dispatchEvent(
      new CustomEvent('nhadat:fengshui-update', {
        detail: res,
      })
    );
  }
</script>
