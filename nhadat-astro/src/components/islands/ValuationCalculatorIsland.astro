---
import { PROVINCES_2025 } from '../../lib/constants/provinces';

interface Props {
  initialProvinceSlug?: string;
}

const { initialProvinceSlug = 'ha-noi' } = Astro.props;
---

<div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm" id="valuation-island">
  <div class="space-y-5">
    <!-- Province Selector -->
    <div>
      <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
        Địa Bàn Bất Động Sản (Tỉnh / Thành Phố)
      </label>
      <select
        id="val-province"
        class="w-full rounded-lg border-slate-300 text-sm font-medium focus:ring-brand-500 focus:border-brand-500 p-2.5 bg-slate-50 border"
      >
        {PROVINCES_2025.map((p) => (
          <option value={p.slug} data-price={p.median_price_m2} selected={p.slug === initialProvinceSlug}>
            {p.name} — Trung vị {p.median_price_m2} tr/m²
          </option>
        ))}
      </select>
    </div>

    <!-- Property Type -->
    <div>
      <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
        Loại Hình Bất Động Sản
      </label>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="val-type-group">
        <button type="button" data-type="nha_mat_pho" data-mult="2.4" class="val-type-btn p-2.5 rounded-lg border text-xs font-medium border-brand-600 bg-brand-50 text-brand-700">
          Nhà Mặt Phố
        </button>
        <button type="button" data-type="nha_ngo_hem" data-mult="1.35" class="val-type-btn p-2.5 rounded-lg border text-xs font-medium border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
          Nhà Trong Ngõ
        </button>
        <button type="button" data-type="can_ho" data-mult="1.1" class="val-type-btn p-2.5 rounded-lg border text-xs font-medium border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
          Căn Hộ Chung Cư
        </button>
        <button type="button" data-type="biet_thu" data-mult="2.0" class="val-type-btn p-2.5 rounded-lg border text-xs font-medium border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
          Biệt Thự / Liền Kề
        </button>
        <button type="button" data-type="dat_nen" data-mult="0.95" class="val-type-btn p-2.5 rounded-lg border text-xs font-medium border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
          Đất Nền Thổ Cư
        </button>
      </div>
    </div>

    <!-- Area Slider -->
    <div>
      <div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-1">
        <span>Diện tích sử dụng (m²)</span>
        <span id="val-area-display" class="text-brand-600 font-bold text-sm">85 m²</span>
      </div>
      <input
        type="range"
        id="val-area-slider"
        min="20"
        max="300"
        value="85"
        step="1"
        class="w-full accent-brand-600 cursor-pointer"
      />
    </div>

    <!-- Road Width Slider -->
    <div>
      <div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-1">
        <span>Độ rộng mặt đường / ngõ (m)</span>
        <span id="val-road-display" class="text-brand-600 font-bold text-sm">5 m (Ô tô tránh)</span>
      </div>
      <input
        type="range"
        id="val-road-slider"
        min="1.5"
        max="25"
        value="5"
        step="0.5"
        class="w-full accent-brand-600 cursor-pointer"
      />
    </div>

    <!-- Legal Checkbox -->
    <div class="flex items-center gap-2 p-3 rounded-xl bg-slate-50 border border-slate-200">
      <input type="checkbox" id="val-redbook" checked class="rounded text-brand-600 focus:ring-brand-500 w-4 h-4" />
      <label for="val-redbook" class="text-xs font-medium text-slate-800">
        Đã có Sổ đỏ / Sổ hồng chính chủ (Đảm bảo pháp lý 100%)
      </label>
    </div>

    <!-- Output Valuation Card -->
    <div class="mt-6 p-5 rounded-2xl bg-gradient-to-br from-slate-900 to-slate-850 text-white shadow-lg space-y-4">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-brand-400 uppercase tracking-wider">Ước Tính Định Giá AI Lượng Hóa</span>
        <span id="val-confidence" class="text-[11px] bg-brand-500/20 text-brand-300 px-2 py-0.5 rounded-full font-medium">Độ tin cậy: 92%</span>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 border-b border-slate-800 pb-3">
        <div>
          <span class="text-xs text-slate-400">Tổng Giá Trị Bất Động Sản</span>
          <div id="val-total-billion" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            14.28 <span class="text-lg font-medium text-brand-400">tỷ đ</span>
          </div>
        </div>
        <div class="text-left sm:text-right">
          <span class="text-xs text-slate-400">Đơn giá ước tính</span>
          <div id="val-price-m2" class="text-lg font-bold text-emerald-400 font-mono">
            168.0 tr/m²
          </div>
        </div>
      </div>

      <!-- Range bounds -->
      <div class="grid grid-cols-2 gap-4 text-xs">
        <div>
          <span class="text-slate-400 block">Khoảng giá thấp (Thanh khoản nhanh):</span>
          <span id="val-lower-bound" class="text-slate-200 font-semibold text-sm">13.14 tỷ đ</span>
        </div>
        <div>
          <span class="text-slate-400 block">Khoảng giá cao (Kỳ vọng):</span>
          <span id="val-upper-bound" class="text-slate-200 font-semibold text-sm">15.42 tỷ đ</span>
        </div>
      </div>

      <div class="p-2.5 rounded-lg bg-slate-800/80 border border-slate-700 text-xs text-slate-300 flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Mô hình định giá tham chiếu 450.000+ tin đăng và dữ liệu quy hoạch địa chính địa phương.</span>
      </div>
    </div>
  </div>
</div>

<script>
  const provSelect = document.getElementById('val-province') as HTMLSelectElement;
  const areaSlider = document.getElementById('val-area-slider') as HTMLInputElement;
  const areaDisplay = document.getElementById('val-area-display');
  const roadSlider = document.getElementById('val-road-slider') as HTMLInputElement;
  const roadDisplay = document.getElementById('val-road-display');
  const redbookCheckbox = document.getElementById('val-redbook') as HTMLInputElement;
  const totalDisplay = document.getElementById('val-total-billion');
  const priceM2Display = document.getElementById('val-price-m2');
  const lowerBoundDisplay = document.getElementById('val-lower-bound');
  const upperBoundDisplay = document.getElementById('val-upper-bound');
  const typeBtns = document.querySelectorAll('.val-type-btn');

  let currentMult = 2.4;

  typeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      typeBtns.forEach((b) => {
        b.className = 'val-type-btn p-2.5 rounded-lg border text-xs font-medium border-slate-200 bg-white text-slate-700 hover:bg-slate-50';
      });
      btn.className = 'val-type-btn p-2.5 rounded-lg border text-xs font-medium border-brand-600 bg-brand-50 text-brand-700';
      currentMult = parseFloat(btn.getAttribute('data-mult') || '1.0');
      recalc();
    });
  });

  function recalc() {
    const selectedOption = provSelect.options[provSelect.selectedIndex];
    const basePrice = parseFloat(selectedOption.getAttribute('data-price') || '36.8');
    const area = parseFloat(areaSlider.value);
    const road = parseFloat(roadSlider.value);
    const hasRedBook = redbookCheckbox.checked;

    if (areaDisplay) areaDisplay.textContent = `${area} m²`;
    if (roadDisplay) {
      const roadNote = road >= 8 ? 'Đường rộng 2 chiều' : road >= 4 ? 'Ô tô tránh' : 'Ngõ xe máy';
      roadDisplay.textContent = `${road} m (${roadNote})`;
    }

    let unitPrice = basePrice * currentMult;
    if (road >= 8) unitPrice *= 1.25;
    else if (road >= 4) unitPrice *= 1.1;

    if (hasRedBook) unitPrice *= 1.15;

    const totalBillion = (unitPrice * area) / 1000;
    const lower = totalBillion * 0.92;
    const upper = totalBillion * 1.08;

    if (totalDisplay) totalDisplay.innerHTML = `${totalBillion.toFixed(2)} <span class="text-lg font-medium text-brand-400">tỷ đ</span>`;
    if (priceM2Display) priceM2Display.textContent = `${unitPrice.toFixed(1)} tr/m²`;
    if (lowerBoundDisplay) lowerBoundDisplay.textContent = `${lower.toFixed(2)} tỷ đ`;
    if (upperBoundDisplay) upperBoundDisplay.textContent = `${upper.toFixed(2)} tỷ đ`;
  }

  provSelect?.addEventListener('change', recalc);
  areaSlider?.addEventListener('input', recalc);
  roadSlider?.addEventListener('input', recalc);
  redbookCheckbox?.addEventListener('change', recalc);
</script>
