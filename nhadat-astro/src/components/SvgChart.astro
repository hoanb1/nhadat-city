---
interface Props {
  mode: 'trend' | 'distribution';
  title?: string;
  subtitle?: string;
  data?: { label: string; value: number }[];
  p25?: number;
  median?: number;
  avg?: number;
  p75?: number;
  statePrice?: number;
  unit?: string;
}

const {
  mode,
  title = 'Biểu Đồ Biến Động Giá',
  subtitle = 'Dữ liệu chưng cất từ giao dịch thực tế',
  data = [
    { label: 'T1', value: 34.2 },
    { label: 'T2', value: 34.8 },
    { label: 'T3', value: 35.1 },
    { label: 'T4', value: 35.5 },
    { label: 'T5', value: 36.0 },
    { label: 'T6', value: 36.8 },
    { label: 'T7', value: 37.2 },
    { label: 'T8', value: 37.9 },
    { label: 'T9', value: 38.4 },
    { label: 'T10', value: 39.1 },
    { label: 'T11', value: 39.8 },
    { label: 'T12', value: 40.5 },
  ],
  p25 = 28.5,
  median = 36.8,
  avg = 38.2,
  p75 = 45.0,
  statePrice = 12.5,
  unit = 'triệu/m²',
} = Astro.props;

// Compute trend SVG coordinates
const width = 600;
const height = 220;
const padding = { top: 25, right: 30, bottom: 35, left: 45 };
const plotWidth = width - padding.left - padding.right;
const plotHeight = height - padding.top - padding.bottom;

const values = data.map((d) => d.value);
const minVal = Math.min(...values) * 0.95;
const maxVal = Math.max(...values) * 1.05;
const range = maxVal - minVal || 1;

const points = data.map((d, i) => {
  const x = padding.left + (i / (data.length - 1)) * plotWidth;
  const y = padding.top + plotHeight - ((d.value - minVal) / range) * plotHeight;
  return { x, y, label: d.label, value: d.value };
});

const polylinePoints = points.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
const areaPoints = `${points[0].x},${padding.top + plotHeight} ${polylinePoints} ${points[points.length - 1].x},${padding.top + plotHeight}`;

// Compute dynamic distribution percentages based on [statePrice, p25, median, p75]
const distValues = [statePrice, p25, median, p75].filter((v) => typeof v === 'number' && !isNaN(v) && v > 0);
const distMin = distValues.length > 0 ? Math.min(...distValues) * 0.75 : 0;
const distMax = distValues.length > 0 ? Math.max(...distValues) * 1.15 : 100;
const distRange = distMax - distMin || 1;

function calcDistPct(val: number, fallback: number): number {
  if (typeof val !== 'number' || isNaN(val) || val <= 0) return fallback;
  const pct = ((val - distMin) / distRange) * 100;
  return Math.max(8, Math.min(92, Math.round(pct * 10) / 10));
}

const statePricePct = calcDistPct(statePrice, 15);
const p25Pct = calcDistPct(p25, 35);
const medianPct = calcDistPct(median, 55);
const p75Pct = calcDistPct(p75, 80);
---

<div class="bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-sm">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h3 class="font-semibold text-slate-900 text-sm sm:text-base">{title}</h3>
      <p class="text-xs text-slate-500 mt-0.5">{subtitle}</p>
    </div>
    <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      SSR Vector
    </span>
  </div>

  {mode === 'trend' ? (
    <div class="w-full overflow-x-auto">
      <svg viewBox={`0 0 ${width} ${height}`} class="w-full h-auto max-h-[240px]" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="chartGradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#10b981" stop-opacity="0.3" />
            <stop offset="100%" stop-color="#10b981" stop-opacity="0.0" />
          </linearGradient>
        </defs>

        <!-- Horizontal grid lines -->
        {[0, 0.25, 0.5, 0.75, 1].map((ratio) => {
          const y = padding.top + plotHeight * (1 - ratio);
          const val = (minVal + range * ratio).toFixed(1);
          return (
            <g>
              <line x1={padding.left} y1={y} x2={width - padding.right} y2={y} stroke="#f1f5f9" stroke-width="1" stroke-dasharray="4" />
              <text x={padding.left - 8} y={y + 3} font-size="10" fill="#94a3b8" text-anchor="end">{val}</text>
            </g>
          );
        })}

        <!-- Area fill -->
        <polygon points={areaPoints} fill="url(#chartGradient)" />

        <!-- Line stroke -->
        <polyline points={polylinePoints} fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Points and labels -->
        {points.map((p, i) => (
          <g>
            <circle cx={p.x} cy={p.y} r="3.5" fill="#ffffff" stroke="#059669" stroke-width="2" />
            <text x={p.x} y={height - 10} font-size="10" fill="#64748b" text-anchor="middle">{p.label}</text>
          </g>
        ))}
      </svg>
      <div class="flex items-center justify-between text-[11px] text-slate-500 px-2 pt-2 border-t border-slate-100">
        <span>Đơn vị: {unit}</span>
        <span>Biên độ tăng trưởng: +{(((values[values.length - 1] - values[0]) / values[0]) * 100).toFixed(1)}% YoY</span>
      </div>
    </div>
  ) : (
    <!-- Distribution / Quantile Mode -->
    <div class="space-y-4">
      <div class="relative pt-6 pb-4">
        <!-- Scale Bar -->
        <div class="h-3 rounded-full bg-gradient-to-r from-emerald-100 via-emerald-300 to-emerald-600 relative">
          <!-- State Price Marker -->
          <div class="absolute -top-6 transform -translate-x-1/2 flex flex-col items-center" style={`left: ${statePricePct}%`}>
            <span class="text-[10px] font-bold text-amber-700 bg-amber-50 px-1 rounded border border-amber-200 whitespace-nowrap">Nhà nước: {statePrice} {unit}</span>
            <div class="w-0.5 h-7 bg-amber-500"></div>
          </div>

          <!-- P25 Marker -->
          <div class="absolute -bottom-6 transform -translate-x-1/2 flex flex-col items-center" style={`left: ${p25Pct}%`}>
            <div class="w-0.5 h-7 bg-slate-400"></div>
            <span class="text-[10px] text-slate-600 whitespace-nowrap">P25: {p25}</span>
          </div>

          <!-- Median Marker -->
          <div class="absolute -top-6 transform -translate-x-1/2 flex flex-col items-center" style={`left: ${medianPct}%`}>
            <span class="text-[10px] font-bold text-emerald-800 bg-emerald-100 px-1 rounded border border-emerald-300 whitespace-nowrap">Trung Vị: {median}</span>
            <div class="w-1 h-7 bg-emerald-600"></div>
          </div>

          <!-- P75 Marker -->
          <div class="absolute -bottom-6 transform -translate-x-1/2 flex flex-col items-center" style={`left: ${p75Pct}%`}>
            <div class="w-0.5 h-7 bg-slate-400"></div>
            <span class="text-[10px] text-slate-600 whitespace-nowrap">P75: {p75}</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-4">
        <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100 text-center">
          <p class="text-[11px] text-slate-500">Giá Nhà Nước</p>
          <p class="text-sm font-bold text-amber-600">{statePrice} <span class="text-[10px] font-normal">{unit}</span></p>
        </div>
        <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100 text-center">
          <p class="text-[11px] text-slate-500">Phân Vị 25% (P25)</p>
          <p class="text-sm font-bold text-slate-700">{p25} <span class="text-[10px] font-normal">{unit}</span></p>
        </div>
        <div class="p-2.5 rounded-lg bg-emerald-50 border border-emerald-100 text-center">
          <p class="text-[11px] text-emerald-700 font-medium">Trung Vị Thị Trường</p>
          <p class="text-sm font-bold text-emerald-700">{median} <span class="text-[10px] font-normal">{unit}</span></p>
        </div>
        <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100 text-center">
          <p class="text-[11px] text-slate-500">Phân Vị 75% (P75)</p>
          <p class="text-sm font-bold text-slate-700">{p75} <span class="text-[10px] font-normal">{unit}</span></p>
        </div>
      </div>
    </div>
  )}
</div>
