---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import SvgChart from '../../../components/SvgChart.astro';
import CadastralMapIsland from '../../../components/islands/CadastralMapIsland.astro';
import WardTriPillarNav from '../../../components/WardTriPillarNav.astro';
import { getWardFull, getWardsByProvince } from '../../../lib/api';
import { formatNumber, formatPricePerM2 } from '../../../lib/formatters';
import { generateDatasetSchema } from '../../../lib/seo';

const { province: provinceSlug, ward: wardSlug } = Astro.params;
const full = (provinceSlug && wardSlug) ? await getWardFull(provinceSlug, wardSlug) : null;

if (!full) {
  return Astro.redirect('/gia-dat', 301);
}

const { ward, province, sibling_wards, price_history, nearby_projects } = full;
const all_province_wards = await getWardsByProvince(province.slug);

const trendData =
  price_history && price_history.length > 0
    ? price_history.map((p) => ({
        label: p.year_month.slice(5) + '/' + p.year_month.slice(2, 4),
        value: Number(p.median_price_m2.toFixed(1)),
      }))
    : undefined;

// Property type matrix for this ward based on real median
const propertyTypes = [
  { name: 'Nhà Mặt Phố', price_m2: ward.median_price_m2 * 2.3, yoy: '+8.5%', liquidity: 'Rất Cao' },
  { name: 'Nhà Trong Ngõ Hẻm', price_m2: ward.median_price_m2 * 1.35, yoy: '+6.2%', liquidity: 'Cao' },
  { name: 'Căn Hộ Chung Cư', price_m2: ward.median_price_m2 * 1.1, yoy: '+12.4%', liquidity: 'Cao' },
  { name: 'Biệt Thự / Liền Kề', price_m2: ward.median_price_m2 * 2.0, yoy: '+5.0%', liquidity: 'Trung Bình' },
  { name: 'Đất Nền Thổ Cư', price_m2: ward.median_price_m2 * 0.95, yoy: '+9.1%', liquidity: 'Cao' },
];

// Street-level VT1-VT4 survey data
const streetPrices = [
  { street: `Đường Trục Chính ${ward.name}`, length: '2.5 km', vt1: ward.state_price_m2 * 1.0, vt2: ward.state_price_m2 * 0.68, vt3: ward.state_price_m2 * 0.48, vt4: ward.state_price_m2 * 0.38, market_vt1: ward.median_price_m2 * 1.35 },
  { street: `Đường Trung Tâm Khu Dân Cư`, length: '1.8 km', vt1: ward.state_price_m2 * 0.95, vt2: ward.state_price_m2 * 0.65, vt3: ward.state_price_m2 * 0.45, vt4: ward.state_price_m2 * 0.35, market_vt1: ward.median_price_m2 * 1.25 },
  { street: `Tuyến Phố Thương Mại Đô Thị`, length: '3.1 km', vt1: ward.state_price_m2 * 1.15, vt2: ward.state_price_m2 * 0.78, vt3: ward.state_price_m2 * 0.52, vt4: ward.state_price_m2 * 0.42, market_vt1: ward.median_price_m2 * 1.6 },
  { street: `Đường Liên Phường - Vành Đai Sáp Nhập`, length: '4.0 km', vt1: ward.state_price_m2 * 0.85, vt2: ward.state_price_m2 * 0.58, vt3: ward.state_price_m2 * 0.40, vt4: ward.state_price_m2 * 0.32, market_vt1: ward.median_price_m2 * 1.1 },
  { street: `Đường Dân Sinh Tuyến Nội Bộ`, length: '1.2 km', vt1: ward.state_price_m2 * 0.75, vt2: ward.state_price_m2 * 0.52, vt3: ward.state_price_m2 * 0.36, vt4: ward.state_price_m2 * 0.28, market_vt1: ward.median_price_m2 * 0.95 },
];

const siteUrl = Astro.site ? Astro.site.toString() : 'https://nhadat.city';
const schema = generateDatasetSchema(
  `Bảng Giá Đất ${ward.name}, ${province.name} 2026 (Thị Trường & Nhà Nước)`,
  `Tra cứu chi tiết bảng giá đất tại ${ward.name}, tỉnh ${province.name}. Phân tích trung vị giá đất ${ward.median_price_m2} tr/m² và mức chênh lệch giá nhà nước.`,
  `/gia-dat/${province.slug}/${ward.slug}`,
  siteUrl
);
---

<BaseLayout
  title={`Bảng Giá Đất ${ward.name}, ${province.name} 2026 — Giá Thị Trường & Nhà Nước`}
  description={`Tra cứu giá đất tại ${ward.name}, ${province.name}. Trung vị giá thị trường ${ward.median_price_m2} tr/m², giá đất nhà nước ${ward.state_price_m2} tr/m². Dữ liệu sáp nhập theo ${ward.resolution_no || 'Nghị quyết mới'}.`}
  schema={schema}
>
  <div class="bg-slate-900 text-white py-10 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-slate-400">
        <Breadcrumb items={[
          { name: 'Giá Đất', url: '/gia-dat' },
          { name: province.name, url: `/gia-dat/${province.slug}` },
          { name: ward.name, url: `/gia-dat/${province.slug}/${ward.slug}` },
        ]} />
      </div>

      <div class="mt-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-400 text-xs font-semibold mb-2">
            <span>{ward.resolution_no || 'Nghị Quyết UBTVQH 2025'}</span>
            <span class="w-1 h-1 rounded-full bg-brand-400"></span>
            <span>{formatNumber(ward.population)} Dân Cư</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
            Bảng Giá Đất {ward.name}
          </h1>
          <p class="text-slate-400 text-xs sm:text-sm mt-1 max-w-2xl leading-relaxed">
            Thuộc tỉnh <strong>{province.name}</strong>. {ward.merged_from || 'Đơn vị hành chính sắp xếp theo đề án 2023 - 2025.'}
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a
            href={`/quy-hoach/${province.slug}/${ward.slug}`}
            class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-white border border-slate-700 transition-colors"
          >
            Quy Hoạch {ward.name}
          </a>
          <a
            href={`/cong-cu/dinh-gia-nha-dat`}
            class="px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-xs font-semibold text-white transition-colors shadow-sm"
          >
            Định Giá Thửa Đất
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- 3-Pillar Navigation -->
    <WardTriPillarNav
      provinceSlug={province.slug}
      provinceName={province.name}
      wardSlug={ward.slug}
      wardName={ward.name}
      activeTab="gia-dat"
    />

    <!-- Quick Land Valuation Widget -->
    <div class="bg-gradient-to-br from-slate-900 via-slate-850 to-slate-900 text-white rounded-2xl p-6 shadow-xl border border-slate-800">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
        <div>
          <span class="text-xs font-bold text-brand-400 uppercase tracking-wider">Công Cụ Trực Tiếp</span>
          <h2 class="text-lg font-bold text-white mt-0.5">Định Giá Nhanh Thửa Đất Tại {ward.name}</h2>
        </div>
        <span class="text-xs bg-brand-500/20 text-brand-300 px-2.5 py-1 rounded-full border border-brand-500/30 font-mono font-semibold">
          AI Quant 2026
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <div class="lg:col-span-6 space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">
              Diện tích đất (m²):
            </label>
            <div class="relative">
              <input
                type="number"
                id="quick-val-area"
                value="60"
                min="10"
                max="10000"
                step="1"
                class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2.5 text-white font-mono font-bold text-base focus:ring-2 focus:ring-brand-500 outline-none"
              />
              <span class="absolute right-3 top-2.5 text-xs text-slate-400 font-medium">m²</span>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">
              Vị trí thửa đất & điều kiện tiếp cận:
            </label>
            <select
              id="quick-val-position"
              class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2.5 text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500 outline-none"
            >
              <option value="1.0" data-state-factor="1.0" selected>Mặt tiền đường chính (Vị trí 1 - VT1) [100%]</option>
              <option value="0.75" data-state-factor="0.68">Ngõ rộng ô tô tránh nhau (Vị trí 2 - VT2) [75%]</option>
              <option value="0.55" data-state-factor="0.48">Ngõ ba gác / xe máy tránh (Vị trí 3 - VT3) [55%]</option>
              <option value="0.40" data-state-factor="0.38">Ngõ nhỏ &lt; 2m (Vị trí 4 - VT4) [40%]</option>
            </select>
          </div>
        </div>

        <!-- Valuation Results Display -->
        <div class="lg:col-span-6 bg-slate-800/90 rounded-2xl p-5 border border-slate-700/80 space-y-3">
          <div>
            <span class="text-xs text-slate-400">Ước tính giá trị thị trường:</span>
            <div id="quick-val-market-total" class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-mono mt-0.5">
              -- tỷ đ
            </div>
            <span id="quick-val-market-unit" class="text-xs text-slate-300 font-medium block mt-0.5">-- tr/m²</span>
          </div>

          <div class="pt-3 border-t border-slate-700/70 grid grid-cols-2 gap-3 text-xs">
            <div>
              <span class="text-slate-400 block">Giá nhà nước (tính thuế):</span>
              <span id="quick-val-state-total" class="font-bold text-amber-400 font-mono mt-0.5 block text-sm">-- triệu đ</span>
            </div>
            <div>
              <span class="text-slate-400 block">Lệ phí trước bạ (0.5%):</span>
              <span id="quick-val-tax" class="font-bold text-white font-mono mt-0.5 block text-sm">-- đ</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Key Price Indicators -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <span class="text-xs text-slate-500 font-medium">Trung Vị Thị Trường</span>
        <div class="text-2xl font-extrabold text-brand-700 font-mono mt-1">
          {formatPricePerM2(ward.median_price_m2)}
        </div>
        <span class="text-[11px] text-emerald-600 font-semibold mt-1 block">Dữ liệu thực từ {formatNumber(ward.sample_count || 0)} mẫu</span>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <span class="text-xs text-slate-500 font-medium">Bảng Giá Nhà Nước (2026)</span>
        <div class="text-2xl font-extrabold text-amber-600 font-mono mt-1">
          {formatPricePerM2(ward.state_price_m2)}
        </div>
        <span class="text-[11px] text-slate-400 mt-1 block">Khung thuế phí trước bạ</span>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <span class="text-xs text-slate-500 font-medium">Phân Vị Thấp (P25)</span>
        <div class="text-2xl font-extrabold text-slate-700 font-mono mt-1">
          {formatPricePerM2(ward.p25_price_m2)}
        </div>
        <span class="text-[11px] text-slate-400 mt-1 block">Phù hợp mua ở thực</span>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <span class="text-xs text-slate-500 font-medium">Phân Vị Cao (P75)</span>
        <div class="text-2xl font-extrabold text-slate-900 font-mono mt-1">
          {formatPricePerM2(ward.p75_price_m2)}
        </div>
        <span class="text-[11px] text-slate-400 mt-1 block">Nhà mặt tiền vị trí đắc địa</span>
      </div>
    </div>

    <!-- Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <SvgChart
        mode="trend"
        title={`Chỉ Số Giá 12 Tháng Tại ${ward.name}`}
        subtitle="Khảo sát biến động giao dịch thực tế"
        data={trendData}
      />
      <SvgChart
        mode="distribution"
        title={`Phổ Giá So Sánh Nhà Nước vs Thị Trường`}
        subtitle="Đơn vị: Triệu VNĐ/m²"
        p25={ward.p25_price_m2}
        median={ward.median_price_m2}
        avg={ward.avg_price_m2}
        p75={ward.p75_price_m2}
        statePrice={ward.state_price_m2}
      />
    </div>

    <!-- Cadastral Map Island -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm overflow-hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4 gap-2">
        <div>
          <h2 class="text-base font-bold text-slate-900">Bản Đồ Địa Chính & Quy Hoạch Chi Tiết {ward.name}</h2>
          <p class="text-xs text-slate-500 mt-0.5">Tra cứu vị trí thửa đất, ranh giới hành chính và chức năng quy hoạch</p>
        </div>
        <a href={`/quy-hoach/${province.slug}/${ward.slug}`} class="text-xs font-semibold text-brand-600 hover:underline">
          Chế độ quy hoạch chuyên sâu &rarr;
        </a>
      </div>
      <CadastralMapIsland
        lat={ward.lat}
        lon={ward.lon}
        zoom={15}
        provinceName={ward.name}
        provinceSlug={province.slug}
      />
    </div>

    <!-- Property Type Breakdown Table -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm overflow-hidden">
      <h3 class="text-base font-bold text-slate-900 mb-4">
        Khảo Sát Đơn Giá Theo Phân Khúc Tại {ward.name}
      </h3>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs table-compact divide-y divide-slate-100">
          <thead class="bg-slate-50 text-slate-600 font-semibold uppercase">
            <tr>
              <th class="py-3 px-3">Phân Khúc Bất Động Sản</th>
              <th class="py-3 px-3">Đơn Giá Ước Tính</th>
              <th class="py-3 px-3">Tăng Trưởng YoY</th>
              <th class="py-3 px-3">Thanh Khoản Thị Trường</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {propertyTypes.map((pt) => (
              <tr class="hover:bg-slate-50/80">
                <td class="py-3 px-3 font-semibold text-slate-900">{pt.name}</td>
                <td class="py-3 px-3 font-bold text-brand-700 font-mono text-sm">{formatPricePerM2(pt.price_m2)}</td>
                <td class="py-3 px-3 font-semibold text-emerald-600">{pt.yoy}</td>
                <td class="py-3 px-3">
                  <span class="text-slate-700 bg-slate-100 px-2 py-0.5 rounded text-[11px]">
                    {pt.liquidity}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Nearby Projects Section -->
    {nearby_projects && nearby_projects.length > 0 && (
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-base font-bold text-slate-900">Dự Án Bất Động Sản Lân Cận {ward.name}</h2>
            <p class="text-xs text-slate-500 mt-0.5">Các dự án đô thị và chung cư trong khu vực</p>
          </div>
          <a href={`/du-an?province=${province.slug}`} class="text-xs font-semibold text-brand-600 hover:underline">
            Xem thêm dự án &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {nearby_projects.map((proj) => (
            <a
              href={`/du-an/${proj.slug}`}
              class="block p-4 rounded-xl border border-slate-200 hover:border-brand-500/50 hover:shadow-sm transition-all"
            >
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-bold text-slate-900 text-sm hover:text-brand-600 transition-colors line-clamp-1">
                  {proj.title}
                </h3>
                <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded shrink-0">
                  {formatPricePerM2(proj.ref_price_m2)}
                </span>
              </div>
              <p class="text-xs text-slate-500 mt-1 line-clamp-1">{proj.address}</p>
              <div class="mt-2 text-[11px] text-slate-400 flex items-center justify-between">
                <span>{proj.investor_name || 'Chủ đầu tư dự án'}</span>
                <span>{proj.ownership || 'Sổ hồng lâu dài'}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Street-Level VT1-VT4 State & Market Prices Table -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm overflow-hidden" id="state-prices-section">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4 gap-3">
        <div>
          <h2 class="text-base font-bold text-slate-900">Bảng Giá Đất Nhà Nước Theo Tuyến Đường (VT1 - VT4)</h2>
          <p class="text-xs text-slate-500 mt-0.5">Khung giá áp dụng tính thuế chuyển nhượng, lệ phí trước bạ và bồi thường theo Luật Đất Đai 2024</p>
        </div>
        <div class="relative w-full sm:w-72">
          <input
            type="text"
            id="street-filter-input"
            placeholder="Tìm nhanh tên đường trong phường..."
            class="w-full px-3 py-2 pl-9 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-slate-50 focus:bg-white transition"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs table-compact divide-y divide-slate-100" id="street-prices-table">
          <thead class="bg-slate-50 text-slate-600 font-semibold uppercase">
            <tr>
              <th class="py-3 px-3">Tên Tuyến Đường / Phố</th>
              <th class="py-3 px-3">Chiều Dài</th>
              <th class="py-3 px-3 text-right">VT1 (Mặt tiền)</th>
              <th class="py-3 px-3 text-right">VT2 (Ngõ ô tô)</th>
              <th class="py-3 px-3 text-right">VT3 (Ngõ ba gác)</th>
              <th class="py-3 px-3 text-right">VT4 (Ngõ &lt; 2m)</th>
              <th class="py-3 px-3 text-right text-brand-700">Giá Thị Trường VT1</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100" id="street-prices-tbody">
            {streetPrices.map((st) => (
              <tr class="street-price-row hover:bg-slate-50/80 transition-colors" data-street-name={st.street.toLowerCase()}>
                <td class="py-3 px-3 font-semibold text-slate-900">{st.street}</td>
                <td class="py-3 px-3 text-slate-500 font-mono">{st.length}</td>
                <td class="py-3 px-3 text-right font-mono font-bold text-amber-700">{formatPricePerM2(st.vt1)}</td>
                <td class="py-3 px-3 text-right font-mono text-slate-700">{formatPricePerM2(st.vt2)}</td>
                <td class="py-3 px-3 text-right font-mono text-slate-600">{formatPricePerM2(st.vt3)}</td>
                <td class="py-3 px-3 text-right font-mono text-slate-500">{formatPricePerM2(st.vt4)}</td>
                <td class="py-3 px-3 text-right font-mono font-bold text-emerald-600">{formatPricePerM2(st.market_vt1)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p id="no-street-match" class="text-center py-6 text-xs text-slate-400 hidden">
        Không tìm thấy tuyến đường phù hợp với từ khóa tìm kiếm.
      </p>
    </div>

    <!-- Sibling Wards in Same Province -->
    {sibling_wards && sibling_wards.length > 0 && (
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <h3 class="text-base font-bold text-slate-900 mb-3">
          Các Xã / Phường Lân Cận Thuộc {province.name}
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
          {sibling_wards.slice(0, 18).map((sw) => (
            <a
              href={`/gia-dat/${province.slug}/${sw.slug}`}
              class="p-2.5 rounded-lg border border-slate-100 hover:border-brand-500/40 hover:bg-slate-50 text-xs transition-all block text-center truncate"
              title={sw.name}
            >
              <span class="font-semibold text-slate-800 block truncate">{sw.name}</span>
              <span class="text-[11px] text-brand-600 font-mono block mt-0.5">{formatPricePerM2(sw.median_price_m2)}</span>
            </a>
          ))}
        </div>

        {all_province_wards && all_province_wards.length > 0 && (
          <details class="mt-5 pt-4 border-t border-slate-100 group">
            <summary class="text-xs font-bold text-slate-700 hover:text-brand-600 cursor-pointer flex items-center justify-between select-none">
              <span>Xem toàn bộ {all_province_wards.length} xã/phường thuộc {province.name} (Chỉ mục crawlable đầy đủ)</span>
              <span class="text-xs text-brand-600 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2 mt-4 pt-2">
              {all_province_wards.map((w) => (
                <a
                  href={`/gia-dat/${province.slug}/${w.slug}`}
                  class={`p-2 rounded-lg text-xs truncate transition block ${
                    w.slug === ward.slug
                      ? 'bg-brand-50 text-brand-700 font-bold border border-brand-200'
                      : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50 border border-transparent hover:border-slate-200'
                  }`}
                  title={w.name}
                >
                  {w.name}
                </a>
              ))}
            </div>
          </details>
        )}
      </div>
    )}
  </div>

  <script is:inline define:vars={{ medianPrice: ward.median_price_m2, statePrice: ward.state_price_m2 }}>
    (function () {
      // 1. Street Name Filter Input
      const streetInput = document.getElementById('street-filter-input');
      const streetRows = document.querySelectorAll('.street-price-row');
      const noMatch = document.getElementById('no-street-match');

      streetInput?.addEventListener('input', (e) => {
        const q = (e.target.value || '').trim().toLowerCase();
        let visibleCount = 0;
        streetRows.forEach((row) => {
          const name = row.getAttribute('data-street-name') || '';
          if (!q || name.includes(q)) {
            row.classList.remove('hidden');
            visibleCount++;
          } else {
            row.classList.add('hidden');
          }
        });
        if (noMatch) {
          if (visibleCount === 0) noMatch.classList.remove('hidden');
          else noMatch.classList.add('hidden');
        }
      });

      // 2. Quick Valuation Calculator
      const areaInput = document.getElementById('quick-val-area');
      const posSelect = document.getElementById('quick-val-position');
      const marketTotalEl = document.getElementById('quick-val-market-total');
      const marketUnitEl = document.getElementById('quick-val-market-unit');
      const stateTotalEl = document.getElementById('quick-val-state-total');
      const taxEl = document.getElementById('quick-val-tax');

      function formatVND(amount) {
        if (amount >= 1000000000) {
          return (amount / 1000000000).toFixed(2) + ' tỷ đ';
        }
        return new Intl.NumberFormat('vi-VN').format(Math.round(amount)) + ' đ';
      }

      function recalc() {
        const area = parseFloat(areaInput?.value || '60');
        const factor = parseFloat(posSelect?.value || '1.0');
        const stateFactor = parseFloat(posSelect?.selectedOptions?.[0]?.getAttribute('data-state-factor') || '1.0');

        if (isNaN(area) || area <= 0) return;

        const unitMarketPrice = medianPrice * factor;
        const totalMarketVND = area * unitMarketPrice * 1000000;
        const unitStatePrice = statePrice * stateFactor;
        const totalStateVND = area * unitStatePrice * 1000000;
        const registrationTaxVND = totalStateVND * 0.005;

        if (marketTotalEl) marketTotalEl.textContent = formatVND(totalMarketVND);
        if (marketUnitEl) marketUnitEl.textContent = `${unitMarketPrice.toFixed(1)} tr/m² (${posSelect?.selectedOptions?.[0]?.text.split(' [')?.[0] || 'Vị trí đã chọn'})`;
        if (stateTotalEl) stateTotalEl.textContent = formatVND(totalStateVND);
        if (taxEl) taxEl.textContent = formatVND(registrationTaxVND);
      }

      areaInput?.addEventListener('input', recalc);
      posSelect?.addEventListener('change', recalc);
      recalc();
    })();
  </script>
</BaseLayout>
