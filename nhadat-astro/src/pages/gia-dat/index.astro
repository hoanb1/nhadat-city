---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProvinceCard from '../../components/ProvinceCard.astro';
import SvgChart from '../../components/SvgChart.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getProvinces, getOverview } from '../../lib/api';
import { generateDatasetSchema } from '../../lib/seo';

const provinces = await getProvinces();
const overview = await getOverview();

const siteUrl = Astro.site ? Astro.site.toString() : 'https://nhadat.city';
const schema = generateDatasetSchema(
  'Bảng Giá Đất 34 Tỉnh Thành Việt Nam 2026 (Chỉ Số Thị Trường & Nhà Nước)',
  'Tra cứu chỉ số giá đất 34 tỉnh thành sau sáp nhập 2025. Phân tích đối chiếu giá thị trường thực tế và bảng giá đất nhà nước mới nhất.',
  '/gia-dat',
  siteUrl
);
---

<BaseLayout
  title="Bảng Giá Đất 34 Tỉnh Thành 2026 — Chỉ Số Thị Trường & Giá Nhà Nước"
  description="Tra cứu chỉ số giá đất 34 tỉnh thành sau sắp xếp sáp nhập 2025. Phân tích đối chiếu trung vị giá thị trường và bảng giá đất nhà nước ban hành theo Luật Đất Đai 2024."
  schema={schema}
>
  <div class="bg-slate-900 text-white py-12 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-slate-400">
        <Breadcrumb items={[{ name: 'Giá Đất Toàn Quốc', url: '/gia-dat' }]} />
      </div>
      <div class="mt-4 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-400 text-xs font-semibold mb-2">
            Luật Đất Đai 2024 • Chuẩn Sáp Nhập 2025
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
            Bảng Chỉ Số Giá Đất 34 Tỉnh Thành Việt Nam
          </h1>
          <p class="text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
            Dữ liệu chưng cất từ hơn 985.000 giao dịch bất động sản trên toàn quốc. Cung cấp góc nhìn lượng hóa minh bạch về trung vị giá, phân vị 25% - 75% và bảng giá nhà nước.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- National Overview Chart Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12">
      <SvgChart
        mode="trend"
        title="Biến Động Chỉ Số Giá Đất Toàn Quốc (12 Tháng)"
        subtitle="Trung vị giá giao dịch bất động sản thực tế (triệu/m²)"
      />
      <SvgChart
        mode="distribution"
        title="Phổ Phân Phối Giá Đất Toàn Quốc"
        subtitle="So sánh phân vị thị trường (P25, Median, P75) với Bảng giá Nhà Nước"
        p25={22.5}
        median={overview.national_median_price_m2}
        avg={39.4}
        p75={48.2}
        statePrice={12.0}
      />
    </div>

    <!-- 34 Provinces Matrix -->
    <div class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-4">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Danh Sách 34 Tỉnh Thành Sau Sáp Nhập</h2>
          <p class="text-xs text-slate-500 mt-0.5">Nhấp vào từng tỉnh để xem chi tiết từng xã/phường và bảng giá đất</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {provinces.map((prov) => (
          <ProvinceCard province={prov} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
