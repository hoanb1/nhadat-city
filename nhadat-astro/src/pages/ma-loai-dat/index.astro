---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { LAND_CODES } from '../../lib/constants/landCodes';
import { generateDatasetSchema } from '../../lib/seo';

const siteUrl = Astro.site ? Astro.site.toString() : 'https://nhadat.city';
const schema = generateDatasetSchema(
  'Từ Điển 52 Mã Loại Đất Theo Luật Đất Đai Việt Nam (ODT, ONT, CLN, LUC, TMD...)',
  'Bảng tra cứu toàn diện 52 ký hiệu mã loại đất trên Sổ đỏ và bản đồ địa chính. Giải thích quyền xây dựng, thời hạn sử dụng và quy định chuyển đổi mục đích.',
  '/ma-loai-dat',
  siteUrl
);

// Group land codes
const residential = LAND_CODES.filter((c) => c.is_residential);
const agricultural = LAND_CODES.filter((c) => c.group_name === 'Đất nông nghiệp');
const nonAgri = LAND_CODES.filter((c) => c.group_name === 'Đất phi nông nghiệp' && !c.is_residential);
---

<BaseLayout
  title="Từ Điển 52 Mã Loại Đất Theo Luật Đất Đai (Ký Hiệu Sổ Đỏ ODT, ONT, CLN, TMD...)"
  description="Bảng tra cứu toàn diện 52 ký hiệu mã loại đất trên Giấy chứng nhận Sổ đỏ và bản đồ địa chính theo Luật Đất Đai Việt Nam. Quy định xây dựng, thời hạn sử dụng và phí chuyển mục đích."
  schema={schema}
>
  <div class="bg-slate-900 text-white py-12 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-slate-400">
        <Breadcrumb items={[{ name: 'Mã Loại Đất', url: '/ma-loai-dat' }]} />
      </div>

      <div class="mt-4 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-400 text-xs font-semibold mb-2">
          <span>Chuẩn Luật Đất Đai 2024</span>
          <span class="w-1 h-1 rounded-full bg-brand-400"></span>
          <span>52 Mã Ký Hiệu Sổ Đỏ</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          Từ Điển 52 Mã Loại Đất & Ký Hiệu Địa Chính
        </h1>
        <p class="text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
          Giải mã chi tiết các ký hiệu loại đất ghi trên trang 2 Giấy chứng nhận (Sổ đỏ, Sổ hồng). Tra cứu quy định xây dựng, điều kiện chuyển mục đích và nghĩa vụ tài chính.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <!-- Section 1: Đất Ở (Residential) -->
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-rose-600"></span>
        <h2 class="text-xl font-bold text-slate-900">Nhóm Đất Ở Dân Dụng (Thổ Cư Lâu Dài)</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {residential.map((code) => (
          <a
            href={`/ma-loai-dat/${code.code.toLowerCase()}`}
            class="p-6 rounded-2xl bg-white border border-slate-200 hover:border-brand-500/50 hover:shadow-md transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <span class="w-5 h-5 rounded-md flex-shrink-0" style={`background-color: ${code.color_hex}`}></span>
                  <span class="font-mono font-extrabold text-xl text-slate-900">{code.code}</span>
                </div>
                <span class="text-xs font-semibold text-rose-700 bg-rose-50 px-2 py-0.5 rounded border border-rose-200">
                  {code.max_term_text}
                </span>
              </div>
              <h3 class="font-bold text-slate-900 text-base mb-2">{code.name}</h3>
              <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">{code.legal_summary}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-brand-600">
              <span>Xem quy định xây dựng & pháp lý</span>
              <span>&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Section 2: Đất Nông Nghiệp -->
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-emerald-600"></span>
        <h2 class="text-xl font-bold text-slate-900">Nhóm Đất Nông Nghiệp (Trồng Cây, Lúa, Rừng)</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {agricultural.map((code) => (
          <a
            href={`/ma-loai-dat/${code.code.toLowerCase()}`}
            class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-brand-500/50 hover:shadow-sm transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <span class="w-4 h-4 rounded" style={`background-color: ${code.color_hex}`}></span>
                  <span class="font-mono font-bold text-lg text-slate-900">{code.code}</span>
                </div>
                <span class="text-[11px] text-slate-500">{code.max_term_text.split(' ')[0]}</span>
              </div>
              <h3 class="font-semibold text-slate-900 text-sm mb-1.5">{code.name}</h3>
              <p class="text-xs text-slate-500 leading-relaxed line-clamp-2">{code.buildable_guide}</p>
            </div>
            <div class="mt-3 pt-2 text-xs font-semibold text-brand-600">
              Tra cứu chuyển mục đích &rarr;
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Section 3: Đất Phi Nông Nghiệp Khác -->
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-amber-600"></span>
        <h2 class="text-xl font-bold text-slate-900">Nhóm Đất Phi Nông Nghiệp & Thương Mại Dịch Vụ</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {nonAgri.map((code) => (
          <a
            href={`/ma-loai-dat/${code.code.toLowerCase()}`}
            class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-brand-500/50 hover:shadow-sm transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <span class="w-4 h-4 rounded" style={`background-color: ${code.color_hex}`}></span>
                  <span class="font-mono font-bold text-lg text-slate-900">{code.code}</span>
                </div>
                <span class="text-[11px] text-amber-700 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200">
                  {code.max_term_text.split(' ')[0]}
                </span>
              </div>
              <h3 class="font-semibold text-slate-900 text-sm mb-1.5">{code.name}</h3>
              <p class="text-xs text-slate-500 leading-relaxed line-clamp-2">{code.legal_summary}</p>
            </div>
            <div class="mt-3 pt-2 text-xs font-semibold text-brand-600">
              Chi tiết quy chuẩn xây dựng &rarr;
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
