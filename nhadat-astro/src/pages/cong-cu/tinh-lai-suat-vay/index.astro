---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import MortgageCalculatorIsland from '../../../components/islands/MortgageCalculatorIsland.astro';
import { calculateMortgage } from '../../../lib/calc/mortgage';
import { BANKS } from '../../../lib/constants/banks';
import { formatVND, formatPercent } from '../../../lib/formatters';
import { generateWebApplicationSchema } from '../../../lib/seo';

// SSR Baseline calculation (2 billion loan, 20 years, 6.0% interest rate)
const sampleMortgage = calculateMortgage(2000000000, 240, 6.0, 'decreasing');

const siteUrl = Astro.site ? Astro.site.toString() : 'https://nhadat.city';
const schema = generateWebApplicationSchema(
  'Công Cụ Tính Lãi Suất Vay Mua Nhà 35 Ngân Hàng',
  'Tính toán bảng lịch trả nợ vay mua nhà trả góp theo dư nợ giảm dần và annuity. So sánh gói vay 35 ngân hàng Big4, TMCP và ngân hàng quốc tế.',
  '/cong-cu/tinh-lai-suat-vay',
  'FinancialApplication',
  siteUrl
);
---

<ToolLayout
  title="Tính Lãi Suất Vay Mua Nhà 35 Ngân Hàng (Bảng Tính Lịch Trả Nợ 2026)"
  description="Công cụ tính lịch trả nợ vay mua nhà trả góp chi tiết từng tháng cho 35 ngân hàng tại Việt Nam. So sánh lãi suất ưu đãi, phí phạt trả nợ trước hạn và hạn mức vay."
  toolName="Tính Lãi Suất Vay Mua Nhà"
  schema={schema}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column: Interactive Calculator Island -->
    <div class="lg:col-span-7 space-y-6">
      <MortgageCalculatorIsland initialBankSlug="vietcombank" />

      <!-- SSR Full Amortization Table (First 12 Months Preview) -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-sm font-bold text-slate-900">Bảng Lịch Trả Nợ 12 Tháng Đầu (SSR Mẫu 2 Tỷ)</h3>
            <p class="text-xs text-slate-500 mt-0.5">Phương thức Dư Nợ Giảm Dần • Lãi suất 6.0%/năm</p>
          </div>
          <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
            Dư Nợ Giảm Dần
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs table-compact divide-y divide-slate-100">
            <thead class="bg-slate-50 text-slate-600 font-semibold">
              <tr>
                <th class="py-2.5 px-3">Kỳ (Tháng)</th>
                <th class="py-2.5 px-3">Gốc Phải Trả</th>
                <th class="py-2.5 px-3">Lãi Phải Trả</th>
                <th class="py-2.5 px-3">Tổng Trả Hàng Tháng</th>
                <th class="py-2.5 px-3">Dư Nợ Còn Lại</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-mono">
              {sampleMortgage.schedule.slice(0, 12).map((item) => (
                <tr class="hover:bg-slate-50/80">
                  <td class="py-2 px-3 font-sans font-medium text-slate-800">Tháng {item.month}</td>
                  <td class="py-2 px-3 text-slate-700">{formatVND(item.principal_paid)}</td>
                  <td class="py-2 px-3 text-amber-600">{formatVND(item.interest_paid)}</td>
                  <td class="py-2 px-3 font-bold text-brand-700">{formatVND(item.total_payment)}</td>
                  <td class="py-2 px-3 text-slate-500">{formatVND(item.remaining_balance)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Right Column: 35 Banks Comparison Matrix -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <h3 class="text-sm font-bold text-slate-900 mb-2">
          Ma Trận Lãi Suất Vay 35 Ngân Hàng
        </h3>
        <p class="text-xs text-slate-500 mb-4 leading-relaxed">
          Cập nhật gói lãi suất vay mua nhà ưu đãi 6 - 12 tháng và biên độ thả nổi sau ưu đãi.
        </p>

        <div class="max-h-[580px] overflow-y-auto divide-y divide-slate-100 text-xs">
          {BANKS.map((bank) => (
            <div class="py-3 flex items-center justify-between hover:bg-slate-50/80 px-1 rounded transition-colors">
              <div>
                <a
                  href={`/cong-cu/tinh-lai-suat-vay/${bank.slug}`}
                  class="font-semibold text-slate-900 hover:text-brand-600 transition-colors block"
                >
                  {bank.short_name}
                </a>
                <span class="text-[11px] text-slate-400">
                  Vay tối đa {bank.max_term_years} năm • LTV {bank.max_ltv_pct}%
                </span>
              </div>
              <div class="text-right">
                <span class="font-bold text-brand-700 text-sm font-mono block">
                  {formatPercent(bank.promo_rate_12m)}
                </span>
                <span class="text-[10px] text-slate-400 font-sans">12 tháng đầu</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</ToolLayout>
