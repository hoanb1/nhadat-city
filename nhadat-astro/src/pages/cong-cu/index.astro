---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const tools = [
  {
    title: 'Chuyển Đổi Tọa Độ VN2000 Sang WGS84',
    description: 'Chuyển đổi tọa độ kinh độ, vĩ độ từ Giấy chứng nhận Sổ đỏ / bản đồ địa chính sang Google Maps và GPS. Hỗ trợ kinh tuyến trục 63 tỉnh và tính diện tích đa giác thửa đất.',
    href: '/cong-cu/chuyen-toa-do-vn2000',
    badge: 'Kinh Tuyến Trục 63 Tỉnh',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  },
  {
    title: 'Định Giá Nhà Đất AI Lượng Hóa',
    description: 'Mô hình máy học định giá tự động (AVM) kết hợp phân vị giá thị trường, độ rộng mặt đường tiếp cận, pháp lý Sổ đỏ và chỉ số hạ tầng từng xã/phường.',
    href: '/cong-cu/dinh-gia-nha-dat',
    badge: 'Quant Model AI',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
  },
  {
    title: 'Tính Lãi Suất Vay Mua Nhà 35 Ngân Hàng',
    description: 'Bảng tính lịch trả nợ chi tiết từng tháng cho cả hai phương thức Dư nợ giảm dần và Trả góp đều (Annuity). Cập nhật gói vay ưu đãi của 35 ngân hàng hàng đầu.',
    href: '/cong-cu/tinh-lai-suat-vay',
    badge: '35 Ngân Hàng',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
  {
    title: 'Tính Thuế Phí Sang Tên Sổ Đỏ',
    description: 'Công cụ tính thuế TNCN 2%, lệ phí trước bạ 0.5%, phí công chứng lũy tiến Thông tư 257/2016/TT-BTC, phí cấp đổi sổ và chuyển mục đích CLN lên ODT.',
    href: '/cong-cu/tinh-thue-phi-sang-ten',
    badge: 'Thông Tư 257/2016',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
  },
  {
    title: 'Xem Hướng Nhà Phong Thủy Bát Trạch',
    description: 'Phân tích hướng nhà theo năm sinh và giới tính gia chủ. La bàn vector 8 hướng xác định Sinh Khí, Diên Niên, Thiên Y và cảnh báo các hướng Tuyệt Mệnh, Ngũ Quỷ.',
    href: '/cong-cu/xem-huong-nha-phong-thuy',
    badge: 'La Bàn Bát Trạch',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/></svg>`,
  },
  {
    title: 'Tính Tỷ Suất Cho Thuê & Net Cap Rate',
    description: 'Đánh giá hiệu quả đầu tư bất động sản cho thuê: tỷ suất sinh lời gộp, Net Cap Rate, dòng tiền thực nhận (Cash-on-Cash) và số năm hoàn vốn.',
    href: '/cong-cu/tinh-ty-suat-cho-thue',
    badge: 'Hiệu Quả Đầu Tư',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
  },
];
---

<BaseLayout
  title="Bộ Công Cụ Tình Báo PropTech & Tài Chính Bất Động Sản"
  description="Trọn bộ 6 công cụ tính toán bất động sản chuẩn xác: chuyển tọa độ VN2000, định giá nhà đất AI, tính lãi vay 35 ngân hàng, tính thuế phí sang tên sổ đỏ, phong thủy Bát Trạch và tỷ suất cho thuê."
>
  <div class="bg-slate-900 text-white py-12 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-slate-400">
        <Breadcrumb items={[{ name: 'Công Cụ', url: '/cong-cu' }]} />
      </div>
      <div class="mt-4 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-400 text-xs font-semibold mb-2">
          Hệ Thống Tính Toán SSOT
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          Trung Tâm Công Cụ Tình Báo PropTech
        </h1>
        <p class="text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
          Tích hợp các thuật toán trắc địa Helmert 7 tham số, mô hình định lượng AI, biểu thuế lũy tiến Thông tư 257 và ma trận lãi suất 35 ngân hàng phục vụ nhà đầu tư và người mua nhà.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tools.map((t) => (
        <ToolCard
          title={t.title}
          description={t.description}
          href={t.href}
          icon={t.icon}
          badge={t.badge}
        />
      ))}
    </div>
  </div>
</BaseLayout>
